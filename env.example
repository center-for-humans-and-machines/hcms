# Model endpoint shared by batch jobs and chat completions. The batch
# regression test (`./script/test -r`, tests/test_regression.py) runs against
# Azure OpenAI, whose responses carry the content-filter blocks it inspects:
# copy .env.azure. It needs MODEL_API_VERSION and a batch deployment. The
# "Regression testing" GitHub workflow runs its chat completions against
# OpenAI direct instead (see .env.openai).
MODEL_API_KEY=
MODEL_ENDPOINT=
MODEL_API_VERSION=2024-08-01-preview
BATCH_MODEL_NAME=gpt-4o-global-batch
CHAT_COMPLETIONS_MODEL_NAME=gpt-4o-2024-08-06

LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=pk-
LANGFUSE_SECRET_KEY=sk-

LLAMA_GUARD_API_KEY=
LLAMA_GUARD_ENDPOINT=

OPENAI_MODERATION_API_KEY=

# Toggle LLM-as-a-judge rating in dataset evaluation.
# Code defaults to true when the variable is absent, but bootstrapped
# setups get this value via .env (which overrides shell exports).
LLM_AS_JUDGE_ENABLED=false

MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DATABASE=
MONGODB_COLLECTION=Conversations
# Change stream server-side await timeout in milliseconds.
MONGODB_CHANGE_STREAM_MAX_AWAIT_MS=1000
# Startup backfill query batch size.
MONGODB_BACKFILL_BATCH_SIZE=200
# Startup backfill per-provider retry budget.
MONGODB_BACKFILL_MAX_RETRIES=10
# Sleep between no-progress startup backfill retries in seconds.
MONGODB_BACKFILL_RETRY_SLEEP_SECONDS=2
# Change stream reconnect exponential backoff base delay in seconds.
MONGODB_RECONNECT_BACKOFF_BASE_SECONDS=1
# Change stream reconnect exponential backoff max delay in seconds.
MONGODB_RECONNECT_BACKOFF_MAX_SECONDS=30
# Random jitter added to reconnect delays in seconds.
MONGODB_RECONNECT_BACKOFF_JITTER_SECONDS=0.25

# Providers the watcher rates and writes, comma-separated
# (openai_moderation, llama_guard, llm_judge; default: all three).
# Each watcher only fills in its own providers' missing reviewer_flags, so a
# deployment without a model's endpoint names the providers it runs (on the
# tower, Llama Guard and the LLM judge each run in their own watcher).
HCMS_MODERATION_PROVIDERS=openai_moderation,llama_guard,llm_judge

# Only backfill messages with a timestamp at or after this ISO 8601 time
# (empty, the default: every unrated message, however old). Set it to cut the
# startup backfill short and rate the rest once with
# `python -m hcms.monitoring.backfill_conversations`.
MONGODB_BACKFILL_SINCE=
# One watcher cycle handles up to this many live events (or this many
# seconds of them), then one due retry, then one backfill batch of
# MONGODB_BACKFILL_BATCH_SIZE messages. A live message waits at most one
# cycle, so a slow provider wants a small batch (LLM judge: 2).
MONGODB_LIVE_MAX_EVENTS_PER_CYCLE=3
MONGODB_LIVE_MAX_SECONDS_PER_CYCLE=60
MONGODB_RETRY_MAX_PER_CYCLE=1

# Threads rating messages concurrently in the watcher (1 = one at a time).
HCMS_WORKER_THREADS=4
# Per-attempt timeout for moderation provider calls, in seconds.
HCMS_PROVIDER_TIMEOUT_SECONDS=30
# Retries the provider client makes after a timeout or transient error.
HCMS_PROVIDER_MAX_RETRIES=2
# Log a warning when a rating lands later than this after its message, in
# seconds (0 disables the warning; the periodic summary still reports lag).
HCMS_RATING_LAG_WARN_SECONDS=120

# Runtime log level (DEBUG, INFO, WARNING, ERROR).
HCMS_LOG_LEVEL=INFO

# LLM judge (HCMS_MODERATION_PROVIDERS=llm_judge): OpenAI-compatible endpoint
# of the llama-server on the tower and its API key
LLM_JUDGE_ENDPOINT=http://127.0.0.1:8081/v1
LLM_JUDGE_API_KEY=your-judge-api-key
# Alias of the pinned model revision/quantization served on the tower
LLM_JUDGE_MODEL=your-pinned-judge-model
# Maximum duration of one inference attempt, in seconds
LLM_JUDGE_TIMEOUT_SECONDS=120
